  "selection": {
    "order": [
      "srcChars",
      "files",
      "cost",
      "ordinal"
    ],
    "topForT3": 2
  },
  "successCriteria": {
    "smallerPatchTasks": 2,
    "text": "B is better if (a) B has a verified winner (T0-T3) on at least one more task than A, or (b) both arms verify the same number of tasks and B's winner has a strictly smaller src diff (changed non-whitespace characters, srcChars) on at least 2 tasks; in both cases B's summed cost must stay within 3.5x A's on every task. Otherwise record NOT_BETTER: do not branch for this task class. A halted or incomplete run is INCONCLUSIVE. A blind human quality ranking is not part of this verdict.",
    "patchSizeMeasure": "srcChars"
  }
